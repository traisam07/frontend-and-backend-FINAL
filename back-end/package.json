{
  "name": "pulsemind-backend",
  "version": "1.0.0",
  "description": "PulseMind ICU respiratory-risk API (Express 4 + Mongoose 6)",
  "main": "server.js",
  "scripts": {
    "start": "node server",
    "dev": "nodemon server",
    "dev:seeded": "cross-env PULSEMIND_MEMORY_DB=1 PULSEMIND_SEED_ON_BOOT=1 node server",
    "seed": "node scripts/seed.js",
    "seed:rebase": "node scripts/seed.js --rebase",
    "seed:generate": "node seed/generate.js",
    "smoke": "node scripts/smoke.js",
    "demo:code": "node scripts/demo-code.js",
    "seed:users": "node scripts/seed-users.js",
    "smoke:auth": "node scripts/auth-check.js"
  },
  "author": "Dave Gray",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "axios": "^1.7.7",
    "bcrypt": "^5.0.1",
    "cookie-parser": "^1.4.5",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "date-fns": "^2.23.0",
    "dotenv": "^10.0.0",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^6.0.11",
    "qrcode": "^1.5.4",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^2.0.12"
  }
}
