# Copy to `.env` and edit. `.env` itself is ignored and must never be committed.
#
#     cp .env.example .env
#
# Every key here is a `PUBLIC_*` SvelteKit variable, which means it is compiled into the client
# bundle and is readable by anyone who loads the page. That is WHY the values below are safe to
# publish, and it is NOT why the file is tracked: `.env` stays ignored regardless, because a
# tracked one is an invitation to add a real credential to it later, and because GitHub's push
# protection flags the filename rather than reading the contents. Anything that is genuinely a
# secret belongs in `back-end/.env`, which is ignored in both repositories.
#
# Live PulseMind pipeline, 2026-08-28.
#
# `pulsemind` selects the third PatientDataSource, `src/lib/data/pulsemind-source.ts`, which talks
# to Node/Express :3500 -> FastAPI :8000 -> the trained booster and a local 7B. Exact string: the
# selector never does a truthiness test, so a mis-spelling falls back to fixtures and renders.
PUBLIC_PULSEMIND_DATA_SOURCE=pulsemind

# SAME ORIGIN, THROUGH THE VITE PROXY. Not a convenience: on two registrable domains the session
# cookie is third-party and Safari drops it, and `Server-Timing` is unreadable to the telemetry
# panel. The proxy no longer rewrites the prefix, because this service mounts under /api.
PUBLIC_PULSEMIND_API_BASE=/api

# The operator strip: restart, advance, stream, warm the explainer, show the pipeline. Off by
# default; nothing clinical depends on it.
PUBLIC_PULSEMIND_DEMO_CONTROLS=true

# Sign-in is not enforced: the live Node API has no /auth surface, so the gate would guard nothing
# and `/login` would be a screen with no service behind it. `fetchSession` cannot throw on a 404,
# so the header simply reports signed out.
PUBLIC_PULSEMIND_REQUIRE_AUTH=false
